generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==================== 基础数据 ====================

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model InventoryLocation {
  id                       String                                   @id @default(cuid())
  code                     String                                   @unique
  name                     String
  note                     String?
  isDefault                Boolean                                  @default(false)
  isActive                 Boolean                                  @default(true)
  sortOrder                Int                                      @default(0)
  deletedAt                DateTime?
  balances                 StockLocationBalance[]
  stockLogs                StockLog[]
  materialIns              MaterialIn[]
  materialReceipts         MaterialReceipt[]
  consumptionReports       DailyProductionReport[]                  @relation("DailyProductionConsumptionLocation")
  productionInputs         DailyProductionConsumption[]             @relation("DailyProductionConsumptionLineLocation")
  outputReports            DailyProductionReport[]                  @relation("DailyProductionOutputLocation")
  orderActualInputs        ProductionOrderActualInput[]             @relation("ProductionOrderActualInputLocation")
  orderActualOutputs       ProductionOrderActualOutput[]            @relation("ProductionOrderActualOutputLocation")
  outgoingTransfers        FlowTransfer[]                           @relation("FlowTransferSourceLocation")
  incomingTransfers        FlowTransfer[]                           @relation("FlowTransferTargetLocation")
  shipments                Shipment[]
  returnOrders             ReturnOrder[]
  inventoryLotBalances     InventoryLotBalance[]
  inventoryLotTransactions InventoryLotTransaction[]
  inventoryLotAllocations  InventoryLotAllocation[]
  shipmentLotAllocations   ShipmentLotAllocation[]
  maintenanceSpareUsages   EquipmentMaintenanceSpareUsage[]
  maintenanceSpareLots     EquipmentMaintenanceSpareLotAllocation[]
  operatorScopes           OperatorInventoryLocationScope[]
  createdAt                DateTime                                 @default(now())
  updatedAt                DateTime                                 @updatedAt

  @@index([sortOrder])
}

model WorkCenter {
  id               String                    @id @default(cuid())
  code             String                    @unique
  name             String
  category         String?
  note             String?
  isActive         Boolean                   @default(true)
  sortOrder        Int                       @default(0)
  deletedAt        DateTime?
  equipment        Equipment[]
  workInstructions WorkInstruction[]
  processSteps     ProcessStep[]
  operatorScopes   OperatorWorkCenterScope[]
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

model Employee {
  id                     String                          @id @default(cuid())
  code                   String                          @unique
  name                   String
  department             String?
  phone                  String?
  note                   String?
  isActive               Boolean                         @default(true)
  sortOrder              Int                             @default(0)
  operatorId             String?                         @unique
  operator               Operator?                       @relation(fields: [operatorId], references: [id], onDelete: SetNull)
  dailyProductionReports DailyProductionReportEmployee[]
  productionOrderActuals ProductionOrderActualEmployee[]
  flowTransfers          FlowTransfer[]
  dispatches             Dispatch[]
  createdAt              DateTime                        @default(now())
  updatedAt              DateTime                        @updatedAt

  @@index([isActive])
  @@index([name])
  @@index([sortOrder])
}

model Equipment {
  id                        String                           @id @default(cuid())
  code                      String                           @unique
  name                      String
  equipmentType             String
  model                     String?
  manufacturer              String?
  serialNumber              String?
  status                    String                           @default("AVAILABLE")
  location                  String?
  basicParameters           String?
  note                      String?
  workCenterId              String
  workCenter                WorkCenter                       @relation(fields: [workCenterId], references: [id], onDelete: Restrict)
  events                    EquipmentEvent[]
  inspectionPlans           EquipmentInspectionPlan[]
  inspectionRecords         EquipmentInspectionRecord[]
  maintenancePlans          EquipmentMaintenancePlan[]
  maintenanceOrders         EquipmentMaintenanceWorkOrder[]
  productionActualSnapshots ProductionOrderActualEquipment[]
  deletedAt                 DateTime?
  createdAt                 DateTime                         @default(now())
  updatedAt                 DateTime                         @updatedAt

  @@index([workCenterId])
  @@index([status])
  @@index([deletedAt])
}

model EquipmentEvent {
  id                           String                         @id @default(cuid())
  equipmentId                  String
  equipment                    Equipment                      @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  eventType                    String
  sourceStatus                 String
  targetStatus                 String
  reason                       String
  note                         String?
  operatorId                   String?
  operatorName                 String
  occurredAt                   DateTime                       @default(now())
  durationSeconds              Int?
  endedAt                      DateTime?
  createdAt                    DateTime                       @default(now())
  inspectionRecord             EquipmentInspectionRecord?
  maintenanceFaultWorkOrder    EquipmentMaintenanceWorkOrder? @relation("MaintenanceFaultEvent")
  maintenanceStartWorkOrder    EquipmentMaintenanceWorkOrder? @relation("MaintenanceStartEvent")
  maintenanceRecoveryWorkOrder EquipmentMaintenanceWorkOrder? @relation("MaintenanceRecoveryEvent")

  @@index([equipmentId, occurredAt])
  @@index([eventType, occurredAt])
  @@index([endedAt])
}

model EquipmentInspectionPlan {
  id           String                        @id @default(cuid())
  code         String                        @unique
  name         String
  equipmentId  String
  equipment    Equipment                     @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  intervalDays Int
  status       String                        @default("ACTIVE")
  nextDueAt    DateTime
  activatedAt  DateTime                      @default(now())
  note         String?
  createdBy    String
  items        EquipmentInspectionPlanItem[]
  records      EquipmentInspectionRecord[]
  createdAt    DateTime                      @default(now())
  updatedAt    DateTime                      @updatedAt

  @@index([equipmentId, status])
  @@index([status, nextDueAt])
}

model EquipmentInspectionPlanItem {
  id        String                      @id @default(cuid())
  planId    String
  plan      EquipmentInspectionPlan     @relation(fields: [planId], references: [id], onDelete: Restrict)
  name      String
  standard  String
  unit      String?
  sortOrder Int                         @default(0)
  results   EquipmentInspectionResult[]
  createdAt DateTime                    @default(now())

  @@unique([planId, sortOrder])
  @@index([planId])
}

model EquipmentInspectionRecord {
  id            String                      @id @default(cuid())
  recordNo      String                      @unique
  operationId   String                      @unique
  planId        String
  plan          EquipmentInspectionPlan     @relation(fields: [planId], references: [id], onDelete: Restrict)
  equipmentId   String
  equipment     Equipment                   @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  dueAt         DateTime
  inspectedAt   DateTime                    @default(now())
  result        String
  inspectorId   String?
  inspectorName String
  note          String?
  faultEventId  String?                     @unique
  faultEvent    EquipmentEvent?             @relation(fields: [faultEventId], references: [id], onDelete: Restrict)
  items         EquipmentInspectionResult[]
  createdAt     DateTime                    @default(now())

  @@unique([planId, dueAt])
  @@index([equipmentId, inspectedAt])
  @@index([result, inspectedAt])
}

model EquipmentInspectionResult {
  id          String                      @id @default(cuid())
  recordId    String
  record      EquipmentInspectionRecord   @relation(fields: [recordId], references: [id], onDelete: Restrict)
  planItemId  String
  planItem    EquipmentInspectionPlanItem @relation(fields: [planItemId], references: [id], onDelete: Restrict)
  itemName    String
  standard    String
  unit        String?
  actualValue String?
  result      String
  note        String?
  sortOrder   Int
  createdAt   DateTime                    @default(now())

  @@unique([recordId, planItemId])
  @@index([recordId, sortOrder])
}

model EquipmentMaintenancePlan {
  id           String                          @id @default(cuid())
  code         String                          @unique
  name         String
  equipmentId  String
  equipment    Equipment                       @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  intervalDays Int
  status       String                          @default("ACTIVE")
  nextDueAt    DateTime
  activatedAt  DateTime                        @default(now())
  note         String?
  createdBy    String
  items        EquipmentMaintenancePlanItem[]
  workOrders   EquipmentMaintenanceWorkOrder[]
  createdAt    DateTime                        @default(now())
  updatedAt    DateTime                        @updatedAt

  @@index([equipmentId, status])
  @@index([status, nextDueAt])
}

model EquipmentMaintenancePlanItem {
  id        String                           @id @default(cuid())
  planId    String
  plan      EquipmentMaintenancePlan         @relation(fields: [planId], references: [id], onDelete: Restrict)
  name      String
  standard  String
  sortOrder Int                              @default(0)
  results   EquipmentMaintenanceWorkResult[]
  createdAt DateTime                         @default(now())

  @@unique([planId, sortOrder])
  @@index([planId])
}

model EquipmentMaintenanceWorkOrder {
  id                    String                           @id @default(cuid())
  workOrderNo           String                           @unique
  createOperationId     String                           @unique
  kind                  String
  equipmentId           String
  equipment             Equipment                        @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  planId                String?
  plan                  EquipmentMaintenancePlan?        @relation(fields: [planId], references: [id], onDelete: Restrict)
  planDueAt             DateTime?
  dueAt                 DateTime?
  title                 String
  priority              String                           @default("NORMAL")
  faultDescription      String?
  assignedTo            String?
  status                String                           @default("OPEN")
  createdById           String?
  createdByName         String
  startedAt             DateTime?
  startedById           String?
  startedByName         String?
  completedAt           DateTime?
  completedById         String?
  completedByName       String?
  completionOperationId String?                          @unique
  cancelledAt           DateTime?
  cancelledById         String?
  cancelledByName       String?
  cancelReason          String?
  workDescription       String?
  failureCause          String?
  faultEventId          String?                          @unique
  faultEvent            EquipmentEvent?                  @relation("MaintenanceFaultEvent", fields: [faultEventId], references: [id], onDelete: Restrict)
  startEventId          String?                          @unique
  startEvent            EquipmentEvent?                  @relation("MaintenanceStartEvent", fields: [startEventId], references: [id], onDelete: Restrict)
  recoveryEventId       String?                          @unique
  recoveryEvent         EquipmentEvent?                  @relation("MaintenanceRecoveryEvent", fields: [recoveryEventId], references: [id], onDelete: Restrict)
  results               EquipmentMaintenanceWorkResult[]
  spares                EquipmentMaintenanceSpareUsage[]
  createdAt             DateTime                         @default(now())
  updatedAt             DateTime                         @updatedAt

  @@index([equipmentId, status])
  @@index([status, dueAt])
  @@index([kind, status])
}

model EquipmentMaintenanceWorkResult {
  id          String                        @id @default(cuid())
  workOrderId String
  workOrder   EquipmentMaintenanceWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  planItemId  String
  planItem    EquipmentMaintenancePlanItem  @relation(fields: [planItemId], references: [id], onDelete: Restrict)
  itemName    String
  standard    String
  result      String
  note        String?
  sortOrder   Int
  createdAt   DateTime                      @default(now())

  @@unique([workOrderId, planItemId])
  @@index([workOrderId, sortOrder])
}

model EquipmentMaintenanceSpareUsage {
  id                    String                                   @id @default(cuid())
  workOrderId           String
  workOrder             EquipmentMaintenanceWorkOrder            @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  materialId            String
  material              Material                                 @relation(fields: [materialId], references: [id], onDelete: Restrict)
  locationId            String
  location              InventoryLocation                        @relation(fields: [locationId], references: [id], onDelete: Restrict)
  stockQty              Float
  valuationQty          Float                                    @default(0)
  costAmount            Float                                    @default(0)
  stockUnitSnapshot     String
  valuationUnitSnapshot String
  conversionRateUsed    Float                                    @default(0)
  costingMethodSnapshot String
  stockLogId            String                                   @unique
  note                  String?
  createdBy             String
  lotAllocations        EquipmentMaintenanceSpareLotAllocation[]
  createdAt             DateTime                                 @default(now())

  @@unique([workOrderId, materialId, locationId])
  @@index([materialId, createdAt])
  @@index([locationId, createdAt])
}

model EquipmentMaintenanceSpareLotAllocation {
  id              String                         @id @default(cuid())
  spareUsageId    String
  spareUsage      EquipmentMaintenanceSpareUsage @relation(fields: [spareUsageId], references: [id], onDelete: Restrict)
  lotId           String
  lot             InventoryLot                   @relation(fields: [lotId], references: [id], onDelete: Restrict)
  locationId      String
  location        InventoryLocation              @relation(fields: [locationId], references: [id], onDelete: Restrict)
  inventoryStatus String                         @default("AVAILABLE")
  stockQty        Float
  valuationQty    Float                          @default(0)
  costAmount      Float                          @default(0)
  createdAt       DateTime                       @default(now())

  @@unique([spareUsageId, lotId, locationId])
  @@index([lotId])
  @@index([locationId])
}

model Product {
  id               String               @id @default(cuid())
  sku              String               @unique
  materialId       String?              @unique
  name             String
  category         String
  customerId       String?
  customer         Customer?            @relation(fields: [customerId], references: [id])
  unit             String               @default("件")
  description      String?
  boms             BOM[]
  bomCostRuns      BomCostRun[]
  processRoutes    ProcessRoute[]
  stock            Stock?
  sawingScenarios  SawingCostScenario[]
  productionOrders ProductionOrder[]
  stockIns         StockIn[]
  shipments        Shipment[]
  returnOrders     ReturnOrder[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
}

model Material {
  id                          String                           @id @default(cuid())
  code                        String                           @unique
  name                        String
  spec                        String?
  note                        String?
  category                    String                           @default("RAW")
  customerId                  String?
  customer                    Customer?                        @relation(fields: [customerId], references: [id])
  unit                        String
  primaryMeasure              String                           @default("QUANTITY")
  stockUnit                   String                           @default("件")
  referenceMeasure            String?
  valuationUnit               String                           @default("kg")
  conversionRate              Float                            @default(1)
  conversionNote              String?
  unitMode                    String                           @default("DUAL")
  unitVersion                 Int                              @default(1)
  costingMethod               String                           @default("WEIGHTED_AVERAGE")
  defaultSalePrice            Float?
  salesCurrency               String                           @default("CNY")
  deletedAt                   DateTime?
  deletedBy                   String?
  stock                       Stock?
  costLayers                  InventoryCostLayer[]
  bomItems                    BOMItem[]
  bomItemOutputs              BOMItem[]                        @relation("BOMItemOutputMaterial")
  bomOutputs                  BOMOutput[]
  pickItems                   PickItem[]
  materialIns                 MaterialIn[]
  productionOrders            ProductionOrder[]                @relation("ProductionOrderTargetMaterial")
  workInstructions            WorkInstruction[]
  processTemplates            ProcessTemplate[]
  dailyProductionReports      DailyProductionReport[]          @relation("DailyProductionFinishedMaterial")
  dailyProductionConsumptions DailyProductionConsumption[]     @relation("DailyProductionConsumedMaterial")
  productionActualInputs      ProductionOrderActualInput[]     @relation("ProductionOrderActualInputMaterial")
  productionActualOutputs     ProductionOrderActualOutput[]    @relation("ProductionOrderActualOutputMaterial")
  flowTransfers               FlowTransfer[]
  shipments                   Shipment[]
  packageDocumentItems        PackageDocumentItem[]
  salesOrderItems             SalesOrderItem[]
  returnOrders                ReturnOrder[]
  inventoryLots               InventoryLot[]
  maintenanceSpareUsages      EquipmentMaintenanceSpareUsage[]
  qualityInspectionStandards  QualityInspectionStandard[]
  createdAt                   DateTime                         @default(now())
}

// ==================== 物料清单 BOM ====================

model BOM {
  id               String            @id @default(cuid())
  productId        String
  product          Product           @relation(fields: [productId], references: [id])
  materialId       String?
  items            BOMItem[]
  outputs          BOMOutput[]
  productionOrders ProductionOrder[]
  costRuns         BomCostRun[]
  name             String            @default("默认方案")
  purpose          String            @default("PRODUCTION")
  version          String            @default("v1")
  status           String            @default("DRAFT")
  isDefault        Boolean           @default(false)
  isActive         Boolean           @default(false)
  outputQuantity   Float             @default(1)
  outputUnit       String            @default("件")
  basedOnBomId     String?
  changeReason     String?
  releasedAt       DateTime?
  releasedBy       String?
  obsoleteAt       DateTime?
  obsoleteBy       String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([productId, version])
  @@index([materialId])
  @@index([productId, status, purpose])
  @@index([basedOnBomId])
  @@index([productId, isActive, isDefault])
  @@index([purpose, isActive, isDefault])
}

model BOMOutput {
  id                 String   @id @default(cuid())
  bomId              String
  bom                BOM      @relation(fields: [bomId], references: [id], onDelete: Cascade)
  materialId         String
  material           Material @relation(fields: [materialId], references: [id])
  quantity           Float    @default(1)
  unit               String
  entryUnit          String?
  entryQuantity      Float?
  conversionRateUsed Float?
  conversionSource   String?
  unitVersionUsed    Int?
  isPrimary          Boolean  @default(false)
  createdAt          DateTime @default(now())

  @@unique([bomId, materialId])
  @@index([materialId])
  @@index([bomId, isPrimary])
}

model BOMItem {
  id                 String              @id @default(cuid())
  bomId              String
  bom                BOM                 @relation(fields: [bomId], references: [id], onDelete: Cascade)
  itemType           String              @default("MATERIAL")
  materialId         String?
  material           Material?           @relation(fields: [materialId], references: [id])
  outputMaterialId   String?
  outputMaterial     Material?           @relation("BOMItemOutputMaterial", fields: [outputMaterialId], references: [id])
  costObjectId       String?
  costObject         CostObject?         @relation(fields: [costObjectId], references: [id])
  sawingScenarioId   String?
  sawingScenario     SawingCostScenario? @relation(fields: [sawingScenarioId], references: [id])
  quantity           Float               @default(0)
  unit               String
  entryUnit          String?
  entryQuantity      Float?
  conversionRateUsed Float?
  conversionSource   String?
  unitVersionUsed    Int?
  wastageRate        Float               @default(0)

  @@unique([bomId, materialId, outputMaterialId])
  @@index([costObjectId])
  @@index([sawingScenarioId])
  @@index([outputMaterialId])
}

model CostObject {
  id         String           @id @default(cuid())
  code       String           @unique
  name       String
  objectType String           @default("MANUAL")
  sourceType String?
  sourceId   String?
  unit       String           @default("件")
  status     String           @default("ACTIVE")
  costs      CostObjectCost[]
  bomItems   BOMItem[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([sourceType, sourceId])
}

model CostObjectCost {
  id                  String     @id @default(cuid())
  costObjectId        String
  costObject          CostObject @relation(fields: [costObjectId], references: [id], onDelete: Cascade)
  version             String     @default("v1")
  materialCostPerUnit Float      @default(0)
  laborHoursPerUnit   Float      @default(0)
  machineHoursPerUnit Float      @default(0)
  directCostPerUnit   Float      @default(0)
  active              Boolean    @default(true)
  effectiveFrom       DateTime   @default(now())
  createdAt           DateTime   @default(now())

  @@index([costObjectId, active])
}

model BomCostRun {
  id                 String           @id @default(cuid())
  productId          String
  product            Product          @relation(fields: [productId], references: [id])
  materialId         String?
  bomId              String?
  bom                BOM?             @relation(fields: [bomId], references: [id])
  bomVersion         String?
  quantityBasis      Float            @default(1)
  laborRatePerHour   Float            @default(0)
  machineRatePerHour Float            @default(0)
  overheadCost       Float            @default(0)
  totalMaterialCost  Float            @default(0)
  totalLaborCost     Float            @default(0)
  totalMachineCost   Float            @default(0)
  totalDirectCost    Float            @default(0)
  totalCost          Float            @default(0)
  unitCost           Float            @default(0)
  createdBy          String?
  createdAt          DateTime         @default(now())
  lines              BomCostRunLine[]

  @@index([productId, createdAt])
  @@index([materialId, createdAt])
  @@index([bomId])
}

model BomCostRunLine {
  id           String     @id @default(cuid())
  runId        String
  run          BomCostRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  lineType     String
  sourceId     String?
  code         String?
  name         String
  quantity     Float      @default(0)
  unit         String
  unitCost     Float      @default(0)
  materialCost Float      @default(0)
  laborHours   Float      @default(0)
  machineHours Float      @default(0)
  laborCost    Float      @default(0)
  machineCost  Float      @default(0)
  directCost   Float      @default(0)
  totalCost    Float      @default(0)
  note         String?
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())

  @@index([runId])
}

// ==================== 工艺路线 ====================

model ProcessRoute {
  id         String        @id @default(cuid())
  productId  String
  product    Product       @relation(fields: [productId], references: [id])
  materialId String?
  name       String
  steps      ProcessStep[]
  isDefault  Boolean       @default(false)
  sortOrder  Int           @default(0)

  @@index([sortOrder])
  @@index([materialId])
}

model ProcessStep {
  id                     String       @id @default(cuid())
  routeId                String
  route                  ProcessRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stepNo                 Int
  name                   String
  defaultTime            Int?
  workstation            String?
  workCenterId           String?
  workCenter             WorkCenter?  @relation(fields: [workCenterId], references: [id], onDelete: SetNull)
  description            String?
  templateId             String?
  templateCode           String?
  standardBatchQty       Int          @default(1000)
  setupTimeMinutes       Float        @default(0)
  cycleTimeSeconds       Float        @default(0)
  peopleCount            Float        @default(1)
  laborRatePerHour       Float        @default(0)
  machineCount           Float        @default(1)
  machineRatePerHour     Float        @default(0)
  energyCostPerHour      Float        @default(0)
  consumableCostPerBatch Float        @default(0)
  yieldRate              Float        @default(1)
  deletedAt              DateTime?
  deletedBy              String?
  reports                WorkReport[]
  dispatches             Dispatch[]

  @@index([workCenterId])
}

model ProcessTemplate {
  id                     String               @id @default(cuid())
  code                   String               @unique
  name                   String
  category               String
  defaultTime            Int?
  workstation            String?
  description            String?
  standardBatchQty       Int                  @default(1000)
  setupTimeMinutes       Float                @default(0)
  cycleTimeSeconds       Float                @default(0)
  peopleCount            Float                @default(1)
  laborRatePerHour       Float                @default(0)
  machineCount           Float                @default(1)
  machineRatePerHour     Float                @default(0)
  energyCostPerHour      Float                @default(0)
  consumableCostPerBatch Float                @default(0)
  yieldRate              Float                @default(1)
  isPreset               Boolean              @default(false)
  sortOrder              Int                  @default(0)
  materials              Material[]
  sawingScenarios        SawingCostScenario[]
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  @@index([sortOrder])
}

model SawingCostScenario {
  id                   String               @id @default(cuid())
  name                 String
  materialLength       Float
  materialWeight       Float
  workpieceLength      Float
  bladeThickness       Float
  rawMaterialPrice     Float
  sawdustPrice         Float
  scrapPrice           Float
  finishedPrice        Float
  quantity             Int
  utilization          Float
  productWeight        Float
  sawdustWeight        Float
  scrapWeight          Float
  netMaterialCost      Float
  materialCostPerPiece Float
  profitPerPiece       Float
  totalRevenue         Float
  totalProfit          Float
  grossMargin          Float
  additionalDirectCost Float                @default(0)
  laborCost            Float                @default(0)
  fixedCost            Float                @default(0)
  directStageCost      Float                @default(0)
  manufacturingCost    Float                @default(0)
  fullCost             Float                @default(0)
  directProfit         Float                @default(0)
  manufacturingProfit  Float                @default(0)
  fullProfit           Float                @default(0)
  directMargin         Float                @default(0)
  manufacturingMargin  Float                @default(0)
  fullMargin           Float                @default(0)
  productKind          String               @default("TEMPORARY")
  productId            String?
  product              Product?             @relation(fields: [productId], references: [id])
  materialId           String?
  laborHoursPerPiece   Float                @default(0)
  machineHoursPerPiece Float                @default(0)
  bomItems             BOMItem[]
  processTemplates     ProcessTemplate[]
  costItems            ProductionCostItem[]
  createdBy            String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([productId])
  @@index([materialId])
}

model ProductionCostItem {
  id          String             @id @default(cuid())
  scenarioId  String
  scenario    SawingCostScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  stage       String
  name        String
  method      String
  inputA      Float              @default(0)
  inputB      Float              @default(0)
  inputC      Float              @default(0)
  amount      Float
  isDeduction Boolean            @default(false)
  note        String?
  sortOrder   Int                @default(0)
  createdAt   DateTime           @default(now())

  @@index([scenarioId, stage])
}

// ==================== 生产工单 ====================

model ProductionOrder {
  id             String    @id @default(cuid())
  orderNo        String    @unique
  groupNo        String?
  lineNo         Int       @default(1)
  voucherNo      String?
  productId      String
  product        Product   @relation(fields: [productId], references: [id])
  materialId     String?
  targetMaterial Material? @relation("ProductionOrderTargetMaterial", fields: [materialId], references: [id])
  bomId          String?
  bom            BOM?      @relation(fields: [bomId], references: [id])
  bomName        String?
  bomVersion     String?
  bomSnapshot    String?   @map("productionBomSnapshot")
  planQty        Float
  completeQty    Float     @default(0)
  scrapQty       Float     @default(0)
  status         String    @default("DRAFT")

  planId      String?
  note        String?
  picks       PickItem[]
  reports     WorkReport[]
  qcRecords   QCRecord[]
  stockIns    StockIn[]
  dispatches  Dispatch[]
  costRecords CostRecord[]
  actuals     ProductionOrderActual[]

  startTime    DateTime?
  completeTime DateTime?
  cancelTime   DateTime?
  cancelReason String?
  deletedAt    DateTime?
  deletedBy    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([materialId])
  @@index([bomId])
  @@index([groupNo, lineNo])
}

model ProductionOrderActual {
  id                             String                                 @id @default(cuid())
  actualNo                       String                                 @unique
  orderId                        String
  order                          ProductionOrder                        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actualDate                     DateTime
  workers                        String
  note                           String?
  equipmentExceptionReason       String?
  workInstructionExceptionReason String?
  status                         String                                 @default("DRAFT")
  confirmedAt                    DateTime?
  confirmedBy                    String?
  reversedAt                     DateTime?
  reversedBy                     String?
  reverseReason                  String?
  employees                      ProductionOrderActualEmployee[]
  equipmentSnapshots             ProductionOrderActualEquipment[]
  workInstructionSnapshots       ProductionOrderActualWorkInstruction[]
  inputs                         ProductionOrderActualInput[]
  outputs                        ProductionOrderActualOutput[]
  lotGenealogies                 InventoryLotGenealogy[]
  createdAt                      DateTime                               @default(now())
  updatedAt                      DateTime                               @updatedAt

  @@index([orderId, actualDate])
  @@index([status])
}

model ProductionOrderActualEquipment {
  id                String                @id @default(cuid())
  actualId          String
  actual            ProductionOrderActual @relation(fields: [actualId], references: [id], onDelete: Cascade)
  sourceEquipmentId String?
  sourceEquipment   Equipment?            @relation(fields: [sourceEquipmentId], references: [id], onDelete: SetNull)
  equipmentCode     String
  equipmentName     String
  equipmentType     String
  equipmentModel    String?
  equipmentStatus   String
  workCenterId      String
  workCenterCode    String
  workCenterName    String
  createdAt         DateTime              @default(now())

  @@unique([actualId, sourceEquipmentId])
  @@index([sourceEquipmentId])
  @@index([workCenterId])
}

model ProductionOrderActualWorkInstruction {
  id                      String                @id @default(cuid())
  actualId                String
  actual                  ProductionOrderActual @relation(fields: [actualId], references: [id], onDelete: Cascade)
  sourceWorkInstructionId String?
  sourceWorkInstruction   WorkInstruction?      @relation(fields: [sourceWorkInstructionId], references: [id], onDelete: SetNull)
  title                   String
  version                 String
  status                  String
  categoryId              String
  categoryName            String
  materialId              String?
  materialCode            String?
  materialName            String?
  workCentersJson         String                @default("[]")
  contentJson             String?
  contentText             String?
  attachmentsJson         String                @default("[]")
  sourceUpdatedAt         DateTime
  createdAt               DateTime              @default(now())

  @@unique([actualId, sourceWorkInstructionId])
  @@index([sourceWorkInstructionId])
  @@index([materialId])
}

model ProductionOrderActualEmployee {
  id           String                @id @default(cuid())
  actualId     String
  actual       ProductionOrderActual @relation(fields: [actualId], references: [id], onDelete: Cascade)
  employeeId   String?
  employee     Employee?             @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  employeeCode String
  employeeName String
  createdAt    DateTime              @default(now())

  @@unique([actualId, employeeId])
  @@index([employeeId])
}

model ProductionOrderActualInput {
  id                 String                   @id @default(cuid())
  actualId           String
  actual             ProductionOrderActual    @relation(fields: [actualId], references: [id], onDelete: Cascade)
  materialId         String
  material           Material                 @relation("ProductionOrderActualInputMaterial", fields: [materialId], references: [id])
  locationId         String
  location           InventoryLocation        @relation("ProductionOrderActualInputLocation", fields: [locationId], references: [id])
  bomItemId          String?
  materialCode       String
  materialName       String
  quantityPerBatch   Float
  lossMode           String                   @default("PERCENT")
  lossValue          Float                    @default(0)
  lossQty            Float                    @default(0)
  plannedQty         Float
  actualQty          Float
  unit               String
  valuationQty       Float                    @default(0)
  valuationUnit      String?
  costAmount         Float                    @default(0)
  conversionRateUsed Float?
  conversionSource   String?
  costingMethod      String?
  costLayerSnapshot  String?
  lotAllocations     InventoryLotAllocation[]
  createdAt          DateTime                 @default(now())

  @@unique([actualId, materialId])
  @@index([materialId])
  @@index([locationId])
}

model ProductionOrderActualOutput {
  id                 String                  @id @default(cuid())
  actualId           String
  actual             ProductionOrderActual   @relation(fields: [actualId], references: [id], onDelete: Cascade)
  materialId         String
  material           Material                @relation("ProductionOrderActualOutputMaterial", fields: [materialId], references: [id])
  locationId         String
  location           InventoryLocation       @relation("ProductionOrderActualOutputLocation", fields: [locationId], references: [id])
  bomOutputId        String?
  materialCode       String
  materialName       String
  quantityPerBatch   Float
  plannedQty         Float
  actualQty          Float
  unit               String
  isPrimary          Boolean                 @default(false)
  valuationQty       Float                   @default(0)
  costAmount         Float                   @default(0)
  stockUnit          String?
  valuationUnit      String?
  conversionRateUsed Float?
  conversionSource   String?
  inventoryLot       InventoryLot?
  lotGenealogies     InventoryLotGenealogy[]
  createdAt          DateTime                @default(now())

  @@unique([actualId, materialId])
  @@index([materialId])
  @@index([locationId])
  @@index([actualId, isPrimary])
}

// ==================== 物料领用 ====================

model PickItem {
  id                    String                 @id @default(cuid())
  orderId               String
  order                 ProductionOrder        @relation(fields: [orderId], references: [id])
  materialId            String
  material              Material               @relation(fields: [materialId], references: [id])
  requiredQty           Float                  @default(0)
  reservedValuationQty  Float                  @default(0)
  actualQty             Float                  @default(0)
  actualValuationQty    Float                  @default(0)
  conversionRateUsed    Float?
  conversionSource      String?
  costAmount            Float                  @default(0)
  costingMethod         String?
  costLayerConsumptions CostLayerConsumption[]
  returnedQty           Float                  @default(0)
  status                String                 @default("PENDING")
  pickedAt              DateTime?
  pickedBy              String?
  createdAt             DateTime               @default(now())
}

// ==================== 工序报工 ====================

model WorkReport {
  id      String          @id @default(cuid())
  orderId String
  order   ProductionOrder @relation(fields: [orderId], references: [id])
  stepId  String
  step    ProcessStep     @relation(fields: [stepId], references: [id])

  workerName String
  workerId   String?

  startTime DateTime
  endTime   DateTime?

  goodQty   Int     @default(0)
  badQty    Int     @default(0)
  badReason String?
  remark    String?
  photoUrls String?

  createdAt DateTime @default(now())
}

// ==================== 旧独立生产记录（入口已移除，待每日盘点切片清理） ====================

model DailyProductionReport {
  id                     String                          @id @default(cuid())
  reportNo               String                          @unique
  reportDate             DateTime
  finishedMaterialId     String
  finishedMaterial       Material                        @relation("DailyProductionFinishedMaterial", fields: [finishedMaterialId], references: [id])
  consumptionLocationId  String?
  consumptionLocation    InventoryLocation?              @relation("DailyProductionConsumptionLocation", fields: [consumptionLocationId], references: [id])
  outputLocationId       String?
  outputLocation         InventoryLocation?              @relation("DailyProductionOutputLocation", fields: [outputLocationId], references: [id])
  outputQty              Float                           @default(0)
  workers                String
  note                   String?
  status                 String                          @default("DRAFT")
  bomId                  String
  bomName                String
  bomVersion             String
  bomType                String
  bomOutputQuantity      Float
  bomOutputUnit          String
  outputValuationQty     Float                           @default(0)
  outputCostAmount       Float                           @default(0)
  outputStockUnit        String?
  outputValuationUnit    String?
  outputConversionRate   Float?
  outputConversionSource String?
  confirmedAt            DateTime?
  confirmedBy            String?
  reversedAt             DateTime?
  reversedBy             String?
  reverseReason          String?
  employees              DailyProductionReportEmployee[]
  consumptions           DailyProductionConsumption[]
  createdAt              DateTime                        @default(now())
  updatedAt              DateTime                        @updatedAt

  @@index([reportDate])
  @@index([finishedMaterialId])
  @@index([status])
}

model DailyProductionReportEmployee {
  id           String                @id @default(cuid())
  reportId     String
  report       DailyProductionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  employeeId   String?
  employee     Employee?             @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  employeeCode String
  employeeName String
  createdAt    DateTime              @default(now())

  @@unique([reportId, employeeId])
  @@index([employeeId])
}

model DailyProductionConsumption {
  id                 String                @id @default(cuid())
  reportId           String
  report             DailyProductionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  materialId         String
  material           Material              @relation("DailyProductionConsumedMaterial", fields: [materialId], references: [id])
  locationId         String
  location           InventoryLocation     @relation("DailyProductionConsumptionLineLocation", fields: [locationId], references: [id])
  bomItemId          String?
  materialCode       String
  materialName       String
  quantityPerUnit    Float
  wastageRate        Float                 @default(0)
  lossMode           String                @default("MANUAL")
  lossValue          Float                 @default(0)
  lossQty            Float                 @default(0)
  plannedQty         Float
  actualQty          Float
  unit               String
  valuationQty       Float                 @default(0)
  valuationUnit      String?
  costAmount         Float                 @default(0)
  conversionRateUsed Float?
  conversionSource   String?
  costingMethod      String?
  costLayerSnapshot  String?
  createdAt          DateTime              @default(now())

  @@index([reportId])
  @@index([materialId])
  @@index([locationId])
}

// ==================== 流程转移 ====================

model FlowTransfer {
  id               String            @id @default(cuid())
  transferNo       String            @unique
  transferDate     DateTime
  materialId       String
  material         Material          @relation(fields: [materialId], references: [id])
  sourceLocationId String
  sourceLocation   InventoryLocation @relation("FlowTransferSourceLocation", fields: [sourceLocationId], references: [id])
  targetLocationId String
  targetLocation   InventoryLocation @relation("FlowTransferTargetLocation", fields: [targetLocationId], references: [id])
  quantity         Float
  unit             String
  employeeId       String?
  employee         Employee?         @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  employeeCode     String?
  operator         String
  note             String?
  status           String            @default("DRAFT")
  confirmedAt      DateTime?
  confirmedBy      String?
  reversedAt       DateTime?
  reversedBy       String?
  reverseReason    String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([transferDate])
  @@index([materialId])
  @@index([sourceLocationId])
  @@index([targetLocationId])
  @@index([employeeId])
  @@index([status])
}

// ==================== 质检记录 ====================

model QCRecord {
  id        String          @id @default(cuid())
  orderId   String
  order     ProductionOrder @relation(fields: [orderId], references: [id])
  checkType String
  sampleQty Int
  goodQty   Int
  badQty    Int
  result    String
  badReason String?
  inspector String
  checkedAt DateTime        @default(now())
  photos    String?
}

// ==================== 库存与入库 ====================

model Stock {
  /// Database triggers require exactly one owner: Material or legacy Product.
  id         String    @id @default(cuid())
  materialId String?   @unique
  material   Material? @relation(fields: [materialId], references: [id])
  productId  String?   @unique
  product    Product?  @relation(fields: [productId], references: [id])

  qty                    Float @default(0)
  reservedQty            Float @default(0)
  availableQty           Float @default(0)
  quarantineQty          Float @default(0)
  holdQty                Float @default(0)
  reworkQty              Float @default(0)
  valuationQty           Float @default(0)
  reservedValuationQty   Float @default(0)
  availableValuationQty  Float @default(0)
  quarantineValuationQty Float @default(0)
  holdValuationQty       Float @default(0)
  reworkValuationQty     Float @default(0)
  totalCost              Float @default(0)
  quarantineCost         Float @default(0)
  holdCost               Float @default(0)
  reworkCost             Float @default(0)
  valuationUnitCost      Float @default(0)
  stockUnitCost          Float @default(0)

  logs             StockLog[]
  locationBalances StockLocationBalance[]
}

model StockLocationBalance {
  id            String            @id @default(cuid())
  stockId       String
  stock         Stock             @relation(fields: [stockId], references: [id], onDelete: Cascade)
  locationId    String
  location      InventoryLocation @relation(fields: [locationId], references: [id])
  qty           Float             @default(0)
  reservedQty   Float             @default(0)
  availableQty  Float             @default(0)
  quarantineQty Float             @default(0)
  holdQty       Float             @default(0)
  reworkQty     Float             @default(0)
  updatedAt     DateTime          @updatedAt

  @@unique([stockId, locationId])
  @@index([locationId])
}

model StockLog {
  id         String             @id @default(cuid())
  stockId    String
  stock      Stock              @relation(fields: [stockId], references: [id])
  locationId String?
  location   InventoryLocation? @relation(fields: [locationId], references: [id])

  type                  String
  qty                   Float
  beforeQty             Float
  afterQty              Float
  valuationQty          Float?
  beforeValuationQty    Float?
  afterValuationQty     Float?
  costAmount            Float?
  beforeCostAmount      Float?
  afterCostAmount       Float?
  stockUnitSnapshot     String?
  valuationUnitSnapshot String?
  conversionRateUsed    Float?
  conversionSource      String?
  costingMethodSnapshot String?
  sourceMovementId      String?
  reversalMovementId    String? @unique
  idempotencyKey        String? @unique
  lotId                 String?
  inventoryStatus       String?
  fromInventoryStatus   String?
  toInventoryStatus     String?

  refType String?
  refId   String?
  note    String?

  createdAt DateTime @default(now())
  createdBy String?

  @@index([lotId])
  @@index([sourceMovementId])
}

model InventoryLot {
  id                          String                                   @id @default(cuid())
  lotNo                       String                                   @unique
  materialId                  String
  material                    Material                                 @relation(fields: [materialId], references: [id], onDelete: Restrict)
  materialInId                String?                                  @unique
  materialIn                  MaterialIn?                              @relation(fields: [materialInId], references: [id], onDelete: Restrict)
  productionOutputId          String?                                  @unique
  productionOutput            ProductionOrderActualOutput?             @relation(fields: [productionOutputId], references: [id], onDelete: Restrict)
  returnOrderId               String?                                  @unique
  returnOrder                 ReturnOrder?                             @relation(fields: [returnOrderId], references: [id], onDelete: Restrict)
  sourceType                  String
  sourceId                    String
  supplierLotNo               String?
  status                      String                                   @default("OPEN")
  receivedAt                  DateTime                                 @default(now())
  reversedAt                  DateTime?
  reversedBy                  String?
  reverseReason               String?
  balances                    InventoryLotBalance[]
  transactions                InventoryLotTransaction[]
  inspections                 QualityInspection[]
  qualityDispositions         QualityDisposition[]
  costLayers                  InventoryCostLayer[]
  productionInputAllocations  InventoryLotAllocation[]
  shipmentAllocations         ShipmentLotAllocation[]
  packageDocumentItems        PackageDocumentItem[]
  returnedLotAllocations      ReturnLotAllocation[]                    @relation("ReturnedInventoryLot")
  maintenanceSpareAllocations EquipmentMaintenanceSpareLotAllocation[]
  parentGenealogies           InventoryLotGenealogy[]                  @relation("InventoryLotGenealogyParent")
  childGenealogies            InventoryLotGenealogy[]                  @relation("InventoryLotGenealogyChild")
  createdAt                   DateTime                                 @default(now())
  updatedAt                   DateTime                                 @updatedAt

  @@index([materialId, status])
  @@index([sourceType, sourceId])
  @@index([supplierLotNo])
}

model InventoryLotAllocation {
  id              String                     @id @default(cuid())
  actualInputId   String
  actualInput     ProductionOrderActualInput @relation(fields: [actualInputId], references: [id], onDelete: Restrict)
  lotId           String
  lot             InventoryLot               @relation(fields: [lotId], references: [id], onDelete: Restrict)
  locationId      String
  location        InventoryLocation          @relation(fields: [locationId], references: [id], onDelete: Restrict)
  inventoryStatus String                     @default("AVAILABLE")
  stockQty        Float
  valuationQty    Float                      @default(0)
  costAmount      Float                      @default(0)
  status          String                     @default("ACTIVE")
  reversedAt      DateTime?
  reversedBy      String?
  createdAt       DateTime                   @default(now())
  genealogies     InventoryLotGenealogy[]

  @@unique([actualInputId, lotId, locationId])
  @@index([lotId, status])
  @@index([actualInputId, status])
  @@index([locationId, status])
}

model InventoryLotGenealogy {
  id                String                      @id @default(cuid())
  inputAllocationId String
  inputAllocation   InventoryLotAllocation      @relation(fields: [inputAllocationId], references: [id], onDelete: Restrict)
  parentLotId       String
  parentLot         InventoryLot                @relation("InventoryLotGenealogyParent", fields: [parentLotId], references: [id], onDelete: Restrict)
  childLotId        String
  childLot          InventoryLot                @relation("InventoryLotGenealogyChild", fields: [childLotId], references: [id], onDelete: Restrict)
  actualId          String
  actual            ProductionOrderActual       @relation(fields: [actualId], references: [id], onDelete: Restrict)
  outputId          String
  output            ProductionOrderActualOutput @relation(fields: [outputId], references: [id], onDelete: Restrict)
  status            String                      @default("ACTIVE")
  reversedAt        DateTime?
  createdAt         DateTime                    @default(now())

  @@unique([inputAllocationId, childLotId])
  @@index([parentLotId, status])
  @@index([childLotId, status])
  @@index([actualId])
  @@index([outputId])
}

model ShipmentLotAllocation {
  id                   String                @id @default(cuid())
  shipmentId           String
  shipment             Shipment              @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  lotId                String
  lot                  InventoryLot          @relation(fields: [lotId], references: [id], onDelete: Restrict)
  locationId           String
  location             InventoryLocation     @relation(fields: [locationId], references: [id], onDelete: Restrict)
  inventoryStatus      String                @default("AVAILABLE")
  stockQty             Float
  valuationQty         Float                 @default(0)
  costAmount           Float                 @default(0)
  returnedStockQty     Float                 @default(0)
  returnedValuationQty Float                 @default(0)
  returnedCostAmount   Float                 @default(0)
  status               String                @default("ACTIVE")
  createdAt            DateTime              @default(now())
  returnAllocations    ReturnLotAllocation[]

  @@unique([shipmentId, lotId, locationId])
  @@index([shipmentId, status])
  @@index([lotId, status])
  @@index([locationId, status])
}

model ReturnLotAllocation {
  id                   String                @id @default(cuid())
  returnOrderId        String
  returnOrder          ReturnOrder           @relation(fields: [returnOrderId], references: [id], onDelete: Restrict)
  shipmentAllocationId String
  shipmentAllocation   ShipmentLotAllocation @relation(fields: [shipmentAllocationId], references: [id], onDelete: Restrict)
  returnedLotId        String
  returnedLot          InventoryLot          @relation("ReturnedInventoryLot", fields: [returnedLotId], references: [id], onDelete: Restrict)
  stockQty             Float
  valuationQty         Float                 @default(0)
  costAmount           Float                 @default(0)
  status               String                @default("ACTIVE")
  createdAt            DateTime              @default(now())

  @@unique([returnOrderId, shipmentAllocationId])
  @@index([returnOrderId, status])
  @@index([shipmentAllocationId, status])
  @@index([returnedLotId, status])
}

model InventoryLotBalance {
  id              String            @id @default(cuid())
  lotId           String
  lot             InventoryLot      @relation(fields: [lotId], references: [id], onDelete: Cascade)
  locationId      String
  location        InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  inventoryStatus String
  stockQty        Float             @default(0)
  valuationQty    Float             @default(0)
  costAmount      Float             @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([lotId, locationId, inventoryStatus])
  @@index([locationId, inventoryStatus])
  @@index([inventoryStatus])
}

model InventoryLotTransaction {
  id             String            @id @default(cuid())
  lotId          String
  lot            InventoryLot      @relation(fields: [lotId], references: [id], onDelete: Restrict)
  locationId     String
  location       InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  type           String
  fromStatus     String?
  toStatus       String?
  stockQty       Float
  valuationQty   Float
  costAmount     Float
  refType        String
  refId          String
  stockLogId     String?
  idempotencyKey String            @unique
  note           String?
  createdBy      String?
  createdAt      DateTime          @default(now())

  @@index([lotId, createdAt])
  @@index([refType, refId])
}

model QualityInspectionStandard {
  id           String                          @id @default(cuid())
  code         String
  version      Int                             @default(1)
  name         String
  materialId   String
  material     Material                        @relation(fields: [materialId], references: [id], onDelete: Restrict)
  sourceType   String
  samplingMode String
  sampleValue  Float                           @default(0)
  minSampleQty Float?
  maxSampleQty Float?
  status       String                          @default("DRAFT")
  changeReason String
  createdBy    String
  releasedAt   DateTime?
  releasedBy   String?
  obsoleteAt   DateTime?
  obsoleteBy   String?
  items        QualityInspectionStandardItem[]
  inspections  QualityInspection[]
  createdAt    DateTime                        @default(now())
  updatedAt    DateTime                        @updatedAt

  @@unique([code, version])
  @@index([materialId, sourceType, status])
  @@index([status, updatedAt])
}

model QualityInspectionStandardItem {
  id                 String                       @id @default(cuid())
  standardId         String
  standard           QualityInspectionStandard    @relation(fields: [standardId], references: [id], onDelete: Restrict)
  name               String
  method             String
  acceptanceCriteria String
  sortOrder          Int                          @default(0)
  inspectionItems    QualityInspectionCheckItem[]
  createdAt          DateTime                     @default(now())

  @@unique([standardId, sortOrder])
  @@index([standardId])
}

model QualityInspection {
  id                       String                       @id @default(cuid())
  inspectionNo             String                       @unique
  lotId                    String
  lot                      InventoryLot                 @relation(fields: [lotId], references: [id], onDelete: Restrict)
  sourceType               String
  sourceId                 String
  round                    Int                          @default(1)
  parentInspectionId       String?
  parentInspection         QualityInspection?           @relation("QualityInspectionRounds", fields: [parentInspectionId], references: [id], onDelete: Restrict)
  followUpInspections      QualityInspection[]          @relation("QualityInspectionRounds")
  requestedByDispositionId String?                      @unique
  requestedByDisposition   QualityDisposition?          @relation("QualityDispositionFollowUp", fields: [requestedByDispositionId], references: [id], onDelete: Restrict)
  dispositions             QualityDisposition[]         @relation("QualityInspectionDispositions")
  standardId               String?
  standard                 QualityInspectionStandard?   @relation(fields: [standardId], references: [id], onDelete: Restrict)
  standardCodeSnapshot     String?
  standardVersionSnapshot  Int?
  standardNameSnapshot     String?
  samplingModeSnapshot     String?
  samplingValueSnapshot    Float?
  minSampleQtySnapshot     Float?
  maxSampleQtySnapshot     Float?
  suggestedSampleQty       Float                        @default(0)
  checkItems               QualityInspectionCheckItem[]
  status                   String                       @default("PENDING")
  result                   String                       @default("PENDING")
  inspectedQty             Float                        @default(0)
  sampleQty                Float                        @default(0)
  goodQty                  Float                        @default(0)
  badQty                   Float                        @default(0)
  inspector                String?
  checkedAt                DateTime?
  note                     String?
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt

  @@index([lotId, status])
  @@index([status, createdAt])
  @@index([sourceType, sourceId])
  @@index([parentInspectionId, round])
  @@index([standardId, status])
}

model QualityInspectionCheckItem {
  id                 String                         @id @default(cuid())
  inspectionId       String
  inspection         QualityInspection              @relation(fields: [inspectionId], references: [id], onDelete: Restrict)
  standardItemId     String?
  standardItem       QualityInspectionStandardItem? @relation(fields: [standardItemId], references: [id], onDelete: Restrict)
  name               String
  method             String
  acceptanceCriteria String
  sortOrder          Int                            @default(0)
  result             String                         @default("PENDING")
  measuredValue      String?
  note               String?
  checkedAt          DateTime?
  createdAt          DateTime                       @default(now())

  @@unique([inspectionId, sortOrder])
  @@index([inspectionId, result])
  @@index([standardItemId])
  @@index([name, result])
}

model QualityDisposition {
  id                 String             @id @default(cuid())
  dispositionNo      String             @unique
  operationId        String             @unique
  inspectionId       String
  inspection         QualityInspection  @relation("QualityInspectionDispositions", fields: [inspectionId], references: [id], onDelete: Restrict)
  lotId              String
  lot                InventoryLot       @relation(fields: [lotId], references: [id], onDelete: Restrict)
  action             String
  sourceStatus       String?
  targetStatus       String?
  stockQty           Float
  valuationQty       Float              @default(0)
  costAmount         Float              @default(0)
  reason             String
  status             String             @default("COMPLETED")
  performedBy        String
  performedAt        DateTime           @default(now())
  followUpInspection QualityInspection? @relation("QualityDispositionFollowUp")
  createdAt          DateTime           @default(now())

  @@index([inspectionId, performedAt])
  @@index([lotId, performedAt])
  @@index([action, performedAt])
}

model StockIn {
  id         String          @id @default(cuid())
  orderId    String
  order      ProductionOrder @relation(fields: [orderId], references: [id])
  productId  String
  product    Product         @relation(fields: [productId], references: [id])
  materialId String?
  qty        Int
  batchNo    String?
  inDate     DateTime        @default(now())
  inBy       String?
  note       String?

  @@index([materialId])
}

// ==================== 客户与供应商 ====================

model Customer {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  contact     String?
  phone       String?
  address     String?
  deletedAt   DateTime?
  deletedBy   String?
  sortOrder   Int          @default(0)
  products    Product[]
  materials   Material[]
  shipments   Shipment[]
  salesOrders SalesOrder[]
  createdAt   DateTime     @default(now())

  @@index([sortOrder])
}

// ==================== 销售订单 ====================

model SalesOrder {
  id           String           @id @default(cuid())
  orderNo      String           @unique
  voucherNo    String?
  customerId   String
  customer     Customer         @relation(fields: [customerId], references: [id])
  status       String           @default("DRAFT")
  orderDate    DateTime         @default(now())
  deliveryDate DateTime?
  totalAmount  Float            @default(0)
  currency     String           @default("CNY")
  note         String?
  deletedAt    DateTime?
  deletedBy    String?
  items        SalesOrderItem[]
  shipments    Shipment[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([customerId])
  @@index([status, orderDate])
}

model SalesOrderItem {
  id                       String     @id @default(cuid())
  salesOrderId             String
  salesOrder               SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  materialId               String
  material                 Material   @relation(fields: [materialId], references: [id])
  qty                      Float
  shippedQty               Float      @default(0)
  unit                     String
  unitPrice                Float      @default(0)
  totalAmount              Float      @default(0)
  currency                 String     @default("CNY")
  priceSource              String     @default("MANUAL")
  defaultSalePriceSnapshot Float?
  priceAdjustedAt          DateTime?
  priceAdjustedBy          String?
  priceAdjustReason        String?
  note                     String?
  shipments                Shipment[]
  createdAt                DateTime   @default(now())

  @@index([salesOrderId])
  @@index([materialId])
}

model Supplier {
  id               String            @id @default(cuid())
  code             String            @unique
  name             String
  contact          String?
  phone            String?
  address          String?
  deletedAt        DateTime?
  deletedBy        String?
  sortOrder        Int               @default(0)
  materialIns      MaterialIn[]
  materialReceipts MaterialReceipt[]
  createdAt        DateTime          @default(now())

  @@index([sortOrder])
}

// ==================== 来料入库 ====================

model MaterialReceipt {
  id                String            @id @default(cuid())
  inboundNo         String            @unique
  voucherNo         String?
  supplierId        String
  supplier          Supplier          @relation(fields: [supplierId], references: [id])
  stagingLocationId String
  stagingLocation   InventoryLocation @relation(fields: [stagingLocationId], references: [id])
  status            String            @default("PENDING")
  inboundDate       DateTime          @default(now())
  receivedBy        String?
  note              String?
  deletedAt         DateTime?
  deletedBy         String?
  lines             MaterialIn[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([supplierId])
  @@index([stagingLocationId])
  @@index([status])
  @@index([inboundDate])
}

model MaterialIn {
  id                    String             @id @default(cuid())
  inboundNo             String             @unique
  receiptId             String?
  receipt               MaterialReceipt?   @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  lineNo                Int                @default(1)
  voucherNo             String?
  supplierId            String
  supplier              Supplier           @relation(fields: [supplierId], references: [id])
  materialId            String
  material              Material           @relation(fields: [materialId], references: [id])
  locationId            String?
  location              InventoryLocation? @relation(fields: [locationId], references: [id])
  qty                   Float
  unit                  String
  pieceCount            Int?
  stockQtyMode          String             @default("TOTAL")
  stockQtyInput         Float?
  totalLength           Float?
  totalWeight           Float?
  valuationQty          Float              @default(0)
  valuationUnit         String             @default("kg")
  conversionRate        Float              @default(1)
  conversionSource      String             @default("MASTER_DEFAULT")
  conversionSampleCount Int                @default(0)
  unitVersionUsed       Int?
  unitPrice             Float              @default(0)
  priceBasis            String             @default("VALUATION")
  priceUnit             String?
  valuationUnitCost     Float              @default(0)
  stockUnitCost         Float              @default(0)
  totalAmount           Float              @default(0)
  batchNo               String?
  status                String             @default("PENDING")
  inboundDate           DateTime           @default(now())
  receivedBy            String?
  note                  String?
  deletedAt             DateTime?
  deletedBy             String?
  inventoryLot          InventoryLot?
  createdAt             DateTime           @default(now())

  @@index([receiptId, lineNo])
}

model InventoryCostLayer {
  id                    String                 @id @default(cuid())
  materialId            String
  material              Material               @relation(fields: [materialId], references: [id])
  materialInId          String?
  sourceType            String?
  sourceId              String?
  stockQty              Float
  remainingStockQty     Float
  valuationQty          Float
  remainingValuationQty Float
  stockUnit             String
  valuationUnit         String
  valuationUnitCost     Float
  stockUnitCost         Float
  totalAmount           Float
  remainingAmount       Float                  @default(0)
  status                String                 @default("OPEN")
  inventoryStatus       String                 @default("AVAILABLE")
  lotId                 String?
  lot                   InventoryLot?          @relation(fields: [lotId], references: [id], onDelete: Restrict)
  createdAt             DateTime               @default(now())
  consumptions          CostLayerConsumption[]

  @@index([materialId])
  @@index([materialInId])
  @@index([sourceType, sourceId])
  @@index([status])
  @@index([lotId])
  @@index([inventoryStatus, status])
}

model CostLayerConsumption {
  id                String             @id @default(cuid())
  pickItemId        String
  pickItem          PickItem           @relation(fields: [pickItemId], references: [id], onDelete: Cascade)
  costLayerId       String
  costLayer         InventoryCostLayer @relation(fields: [costLayerId], references: [id])
  materialId        String
  stockQty          Float
  valuationQty      Float
  costAmount        Float
  stockUnitCost     Float
  valuationUnitCost Float
  restoredAt        DateTime?
  createdAt         DateTime           @default(now())

  @@index([pickItemId])
  @@index([costLayerId])
  @@index([materialId])
  @@index([restoredAt])
}

// ==================== 派工管理 ====================

model Dispatch {
  id           String          @id @default(cuid())
  dispatchNo   String          @unique
  voucherNo    String?
  orderId      String
  order        ProductionOrder @relation(fields: [orderId], references: [id])
  stepId       String
  step         ProcessStep     @relation(fields: [stepId], references: [id])
  workerName   String
  workerId     String?
  employeeId   String?
  employee     Employee?       @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  planQty      Int
  priority     String          @default("NORMAL")
  status       String          @default("PENDING")
  dispatchedAt DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  note         String?
  deletedAt    DateTime?
  deletedBy    String?
  createdAt    DateTime        @default(now())

  @@index([employeeId])
}

// ==================== 发货管理 ====================

model Shipment {
  id                    String                  @id @default(cuid())
  shipmentNo            String                  @unique
  voucherNo             String?
  productId             String
  product               Product                 @relation(fields: [productId], references: [id])
  materialId            String?
  material              Material?               @relation(fields: [materialId], references: [id])
  locationId            String?
  location              InventoryLocation?      @relation(fields: [locationId], references: [id])
  customerId            String?
  customerRef           Customer?               @relation(fields: [customerId], references: [id])
  salesOrderId          String?
  salesOrder            SalesOrder?             @relation(fields: [salesOrderId], references: [id])
  salesOrderItemId      String?
  salesOrderItem        SalesOrderItem?         @relation(fields: [salesOrderItemId], references: [id])
  qty                   Float
  unitPrice             Float                   @default(0)
  totalAmount           Float                   @default(0)
  customer              String
  customerPhone         String?
  address               String?
  status                String                  @default("PENDING")
  shippedAt             DateTime?
  shippedBy             String?
  lotTraceStatus        String                  @default("PENDING")
  shippedValuationQty   Float                   @default(0)
  shippedCostAmount     Float                   @default(0)
  stockUnitSnapshot     String?
  valuationUnitSnapshot String?
  conversionRateUsed    Float?
  conversionSource      String?
  trackingNo            String?
  note                  String?
  deletedAt             DateTime?
  deletedBy             String?
  returnOrders          ReturnOrder[]
  lotAllocations        ShipmentLotAllocation[]
  packages              PackageDocument[]
  createdAt             DateTime                @default(now())

  @@index([materialId])
  @@index([salesOrderId])
  @@index([salesOrderItemId])
}

model PackageDocument {
  id           String                @id @default(cuid())
  packageNo    String                @unique
  shipmentId   String
  shipment     Shipment              @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  status       String                @default("PACKED")
  packedBy     String
  packedAt     DateTime              @default(now())
  grossWeight  Float?
  netWeight    Float?
  weightUnit   String                @default("kg")
  lengthMm     Float?
  widthMm      Float?
  heightMm     Float?
  sealNo       String?
  note         String?
  deletedAt    DateTime?
  deletedBy    String?
  items        PackageDocumentItem[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([shipmentId, status])
  @@index([packedAt])
}

model PackageDocumentItem {
  id                String          @id @default(cuid())
  packageDocumentId String
  packageDocument   PackageDocument @relation(fields: [packageDocumentId], references: [id], onDelete: Restrict)
  materialId        String
  material          Material        @relation(fields: [materialId], references: [id], onDelete: Restrict)
  inventoryLotId    String?
  inventoryLot      InventoryLot?   @relation(fields: [inventoryLotId], references: [id], onDelete: Restrict)
  quantity          Float
  unitSnapshot      String
  lotNoSnapshot     String?
  note              String?
  createdAt         DateTime        @default(now())

  @@index([packageDocumentId])
  @@index([materialId])
  @@index([inventoryLotId])
}

// ==================== 扫码计数与标签打印 ====================

model ScanCountSession {
  id              String           @id @default(cuid())
  sessionNo       String           @unique
  clientRequestId String?          @unique
  name            String?
  purpose         String           @default("SHIPMENT")
  referenceType   String
  referenceId     String
  expectedCode    String
  expectedQty     Float
  countedQty      Float            @default(0)
  status          String           @default("OPEN")
  scannerModel    String?
  createdBy       String?
  completedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  events          ScanCountEvent[]

  @@index([referenceType, referenceId, status])
}

model ScanCountEvent {
  id            String           @id @default(cuid())
  clientEventId String?          @unique
  sessionId     String
  session       ScanCountSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  rawValue      String
  code          String
  quantity      Float            @default(1)
  result        String
  createdAt     DateTime         @default(now())

  @@index([sessionId, createdAt])
}

model LabelPrintJob {
  id              String   @id @default(cuid())
  jobNo           String   @unique
  clientRequestId String?  @unique
  templateType    String
  referenceType   String
  referenceId     String
  printerModel    String
  printerDpi      Int
  printerIp       String?
  labelWidthMm    Float
  labelHeightMm   Float
  copies          Int      @default(1)
  payloadJson     String?
  status          String   @default("REQUESTED")
  requestedBy     String?
  requestedAt     DateTime @default(now())

  @@index([referenceType, referenceId, requestedAt])
}

// ==================== 退货管理 ====================

model ReturnOrder {
  id                    String                @id @default(cuid())
  returnNo              String                @unique
  voucherNo             String?
  shipmentId            String?
  shipment              Shipment?             @relation(fields: [shipmentId], references: [id])
  productId             String
  product               Product               @relation(fields: [productId], references: [id])
  materialId            String?
  material              Material?             @relation(fields: [materialId], references: [id])
  locationId            String?
  location              InventoryLocation?    @relation(fields: [locationId], references: [id])
  qty                   Float
  processedValuationQty Float                 @default(0)
  processedCostAmount   Float                 @default(0)
  stockUnitSnapshot     String?
  valuationUnitSnapshot String?
  conversionRateUsed    Float?
  conversionSource      String?
  reason                String
  status                String                @default("PENDING")
  processedAt           DateTime?
  processedBy           String?
  note                  String?
  deletedAt             DateTime?
  deletedBy             String?
  inventoryLot          InventoryLot?
  lotAllocations        ReturnLotAllocation[]
  createdAt             DateTime              @default(now())

  @@index([materialId])
}

model AuditLog {
  id           String   @id @default(cuid())
  operatorId   String?
  operatorName String?
  action       String
  entityType   String
  entityId     String?
  entityLabel  String?
  beforeData   String?
  afterData    String?
  note         String?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([entityType, entityId])
  @@index([operatorId])
  @@index([createdAt])
}

// ==================== 成本统计 ====================

model CostRecord {
  id          String           @id @default(cuid())
  orderId     String?
  order       ProductionOrder? @relation(fields: [orderId], references: [id])
  costType    String
  category    String
  amount      Float
  description String?
  date        DateTime
  createdBy   String?
  createdAt   DateTime         @default(now())
}

// ==================== 原始单据附件 ====================

model DocumentAttachment {
  id               String            @id @default(cuid())
  ownerType        String
  ownerId          String
  documentType     String            @default("ORIGINAL")
  originalName     String
  fileName         String
  mimeType         String
  size             Int
  url              String
  storagePath      String
  note             String?
  uploadedBy       String?
  isCover          Boolean           @default(false)
  rotation         Int               @default(0)
  deletedAt        DateTime?
  deletedBy        String?
  createdAt        DateTime          @default(now())
  wopiViewSessions WopiViewSession[]

  @@index([ownerType, ownerId])
}

// ==================== 作业指导书 ====================

model WorkInstruction {
  id                        String                                 @id @default(cuid())
  categoryId                String
  category                  DocumentCategory                       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  title                     String
  version                   String                                 @default("v1")
  status                    String                                 @default("ACTIVE")
  materialId                String?
  material                  Material?                              @relation(fields: [materialId], references: [id], onDelete: Restrict)
  workCenters               WorkCenter[]
  productionActualSnapshots ProductionOrderActualWorkInstruction[]
  contentJson               String?
  contentText               String?
  note                      String?
  deletedAt                 DateTime?
  deletedBy                 String?
  createdAt                 DateTime                               @default(now())
  updatedAt                 DateTime                               @updatedAt

  @@index([categoryId])
  @@index([status])
  @@index([materialId])
}

model DocumentCategory {
  id               String             @id @default(cuid())
  name             String
  parentId         String?
  parent           DocumentCategory?  @relation("DocumentCategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children         DocumentCategory[] @relation("DocumentCategoryHierarchy")
  sortOrder        Int                @default(0)
  workInstructions WorkInstruction[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([parentId])
  @@index([sortOrder])
}

// ==================== 操作人员与注册审核 ====================

model Operator {
  id                  String                       @id @default(cuid())
  username            String                       @unique
  passwordHash        String
  name                String
  phone               String?
  role                String                       @default("OPERATOR")
  status              String                       @default("PENDING")
  approvedAt          DateTime?
  approvedBy          String?
  lastLoginAt         DateTime?
  failedLoginAttempts Int                          @default(0)
  lockedUntil         DateTime?
  lastFailedLoginAt   DateTime?
  employee            Employee?
  sessions            OperatorSession[]
  wopiViewSessions    WopiViewSession[]
  authAccounts        OperatorAuthAccount[]
  permissionOverrides OperatorPermissionOverride[]
  permissionGroups    OperatorPermissionGroup[]
  workspacePreference OperatorWorkspacePreference?
  functionUsages      OperatorFunctionUsage[]
  dataScope           OperatorDataScope?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
}

model OperatorDataScope {
  operatorId     String                           @id
  operator       Operator                         @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  productionMode String                           @default("ALL")
  inventoryMode  String                           @default("ALL")
  workCenters    OperatorWorkCenterScope[]
  locations      OperatorInventoryLocationScope[]
  createdAt      DateTime                         @default(now())
  updatedAt      DateTime                         @updatedAt
}

model OperatorWorkCenterScope {
  operatorId   String
  dataScope    OperatorDataScope @relation(fields: [operatorId], references: [operatorId], onDelete: Cascade)
  workCenterId String
  workCenter   WorkCenter        @relation(fields: [workCenterId], references: [id], onDelete: Cascade)
  createdAt    DateTime          @default(now())

  @@id([operatorId, workCenterId])
  @@index([workCenterId])
}

model OperatorInventoryLocationScope {
  operatorId String
  dataScope  OperatorDataScope @relation(fields: [operatorId], references: [operatorId], onDelete: Cascade)
  locationId String
  location   InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  createdAt  DateTime          @default(now())

  @@id([operatorId, locationId])
  @@index([locationId])
}

model OperatorWorkspacePreference {
  operatorId String   @id
  operator   Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  mode       String   @default("DEFAULT")
  layoutJson String   @default("[]")
  pinnedJson String   @default("[]")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model OperatorFunctionUsage {
  id          String   @id @default(cuid())
  operatorId  String
  operator    Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  functionKey String
  useCount    Int      @default(0)
  lastUsedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([operatorId, functionKey])
  @@index([operatorId, useCount])
}

model OperatorAuthAccount {
  id             String   @id @default(cuid())
  operatorId     String
  operator       Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  provider       String
  providerUserId String
  unionId        String?
  nickname       String?
  avatarUrl      String?
  rawData        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([provider, providerUserId])
  @@index([operatorId])
  @@index([unionId])
}

model PermissionSetting {
  id        String   @id @default(cuid())
  role      String
  resource  String
  canRead   Boolean  @default(false)
  canCreate Boolean  @default(false)
  canUpdate Boolean  @default(false)
  canDelete Boolean  @default(false)
  canGrant  Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([role, resource])
  @@index([role])
}

model OperatorPermissionOverride {
  id              String    @id @default(cuid())
  operatorId      String
  operator        Operator  @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  resource        String
  canRead         Boolean   @default(false)
  canCreate       Boolean   @default(false)
  canUpdate       Boolean   @default(false)
  canDelete       Boolean   @default(false)
  canGrant        Boolean   @default(false)
  reason          String?
  grantedBy       String?
  startsAt        DateTime?
  expiresAt       DateTime?
  legacyPermanent Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([operatorId, resource])
  @@index([operatorId])
  @@index([expiresAt])
}

model PermissionGroup {
  id          String                    @id @default(cuid())
  code        String                    @unique
  name        String
  description String?
  isSystem    Boolean                   @default(false)
  settings    PermissionGroupSetting[]
  operators   OperatorPermissionGroup[]
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
}

model PermissionGroupSetting {
  id        String          @id @default(cuid())
  groupId   String
  group     PermissionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  resource  String
  canRead   Boolean         @default(false)
  canCreate Boolean         @default(false)
  canUpdate Boolean         @default(false)
  canDelete Boolean         @default(false)
  canGrant  Boolean         @default(false)
  updatedAt DateTime        @updatedAt

  @@unique([groupId, resource])
  @@index([groupId])
}

model OperatorPermissionGroup {
  id         String          @id @default(cuid())
  operatorId String
  operator   Operator        @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  groupId    String
  group      PermissionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now())

  @@unique([operatorId, groupId])
  @@index([operatorId])
  @@index([groupId])
}

model OperatorSession {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([operatorId])
}

model WopiViewSession {
  id             String             @id @default(cuid())
  tokenHash      String             @unique
  attachmentId   String
  attachment     DocumentAttachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  operatorId     String
  operator       Operator           @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  revokedAt      DateTime?
  lastAccessedAt DateTime?
  createdAt      DateTime           @default(now())

  @@index([attachmentId, expiresAt])
  @@index([operatorId, expiresAt])
  @@index([expiresAt])
}

model AuthenticationThrottle {
  id              String    @id @default(cuid())
  scope           String
  keyHash         String
  windowStartedAt DateTime
  attemptCount    Int       @default(0)
  blockedUntil    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([scope, keyHash])
  @@index([blockedUntil])
  @@index([updatedAt])
}
