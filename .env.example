# 本地运行。Coolify 中改为 file:/app/data/mes_lite.db
DATABASE_URL="file:./mes_lite.db"

# 微信开放平台网站应用扫码登录。未配置时网页登录页会禁用微信登录。
WECHAT_WEB_APP_ID=
WECHAT_WEB_APP_SECRET=
WECHAT_WEB_REDIRECT_URI=http://localhost:3002/api/auth/wechat/callback

# MES-lite 全局只读 AI 助手。默认接口为阿里云百炼 OpenAI 兼容地址。
AI_AGENT_ENABLED=true
AI_AGENT_PROVIDER_NAME=通义千问
AI_AGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_AGENT_MODEL=
AI_AGENT_API_KEY=
AI_AGENT_TIMEOUT_MS=45000
AI_AGENT_MAX_TOOL_ROUNDS=4
