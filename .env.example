# 本地运行。Coolify 中改为 file:/app/data/mes_lite.db
DATABASE_URL="file:./mes_lite.db"
MES_LITE_DATABASE_PATH=prisma/mes_lite.db
MES_LITE_DATA_DIR=prisma
MES_LITE_UPLOAD_DIR=public/uploads
MES_LITE_BACKUP_DIR=.runtime/backups
MES_LITE_BACKUP_RETENTION_COUNT=30
MES_LITE_BACKUP_RETENTION_DAYS=14
MES_LITE_BACKUP_MAX_AGE_HOURS=26
MES_LITE_PRE_MIGRATION_BACKUP_ENABLED=false

# 浏览器写请求只接受这些同源地址，多个地址用英文逗号分隔。
MES_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
# 公开注册默认关闭；临时开放时新账号仍统一进入待审核状态。
MES_PUBLIC_REGISTRATION_ENABLED=false
# 首次安装管理员时临时设置至少 32 字符的随机令牌，安装完成后立即删除。
MES_INITIAL_ADMIN_TOKEN=

# Optional read-only business-directory.v1 provider. Off by default, independent MES login is unchanged.
# Source labels describe this single-instance deployment; they do not add database tenant isolation.
# Runtime secrets only. Delegate must already exist, remain ACTIVE and have customers.read.
BUSINESS_DIRECTORY_ENABLED=false
BUSINESS_DIRECTORY_API_KEY_SHA256=
BUSINESS_DIRECTORY_OPERATOR_ID=
BUSINESS_DIRECTORY_INSTANCE_ID=
BUSINESS_DIRECTORY_TENANT_ID=
BUSINESS_DIRECTORY_WORKSPACE_ID=
BUSINESS_DIRECTORY_EXPIRES_AT=

# Non-secret build-time navigation target; change for a future domain or workspace.
# Empty disables data-platform links. Target login and permissions remain independent.
NEXT_PUBLIC_DATA_PLATFORM_WORKSPACE_URL=https://fix.xiangshu.me/workspaces/local/default

# 可选：隔离部署的 DWG/DXF 转 PDF 服务。未配置时仍可保存和下载 CAD 原文件。
CAD_PREVIEW_SERVICE_URL=
CAD_PREVIEW_SERVICE_TOKEN=
CAD_PREVIEW_TIMEOUT_MS=120000

# 微信开放平台网站应用扫码登录。未配置时网页登录页会禁用微信登录。
WECHAT_WEB_APP_ID=
WECHAT_WEB_APP_SECRET=
WECHAT_WEB_REDIRECT_URI=http://localhost:3002/api/auth/wechat/callback

# MES-lite 全局只读 AI 助手。默认接口为阿里云百炼 OpenAI 兼容地址。
AI_AGENT_ENABLED=true
AI_AGENT_PROVIDER_NAME=通义千问
AI_AGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_AGENT_MODEL=
AI_AGENT_API_KEY=
# 页面保存 API Key 的加密主密钥。生产环境使用 `openssl rand -hex 32` 生成并长期保留。
AI_AGENT_CONFIG_SECRET=
AI_AGENT_TIMEOUT_MS=45000
AI_AGENT_MAX_TOOL_ROUNDS=4
